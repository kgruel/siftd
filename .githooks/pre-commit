#!/usr/bin/env bash
# Tracked pre-commit hook: lint, then regenerate generated docs and stage them
# so every commit carries fresh generated spans. Wired per-clone by ./dev setup
# (`git config core.hooksPath .githooks`).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

./dev lint

# Regenerate docs/reference/ and the managed README spans, then stage the
# results (no-op when nothing changed). Skipped before ./dev setup has run.
if [ -d .venv ]; then
    ./dev docs
    git add docs/reference/
    uv run python scripts/gen_docs.py readmes --list | xargs git add
fi
