# .claude/ is machine-local (settings, plans, worktrees) EXCEPT skills and
# commands, which are shared developer assets. `.claude/*` (not `.claude/`)
# so the negations below can re-include — git won't descend into a fully
# ignored directory.
.claude/*
!.claude/skills/
!.claude/commands/
.DS_Store
